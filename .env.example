# ---- Core ----
PORT=3000
# Public origin this app is reached at. Loopback (127.0.0.1) turns on dev mode,
# which uses atproto's special `http://localhost` development client_id and needs no keys.
PUBLIC_URL=http://127.0.0.1:3000
# In production: PUBLIC_URL=https://shitsky38.com

# Secret used to sign the login cookie. Generate: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
COOKIE_SECRET=change-me-to-something-long-and-random

# ---- Contest rules ----
SITE_NAME=Shitsky38
LIST_SIZE=38
MAX_VOTES=10
VOTING_OPENS_AT=2026-09-01T00:00:00.000Z
VOTING_CLOSES_AT=2026-12-31T23:59:59.000Z

# Permissions requested at sign-in. The default asks only to write this app's two record types.
# Set to "atproto transition:generic" to fall back to App Password level access.
# SCOPE=

# DIDs allowed into the /admin audit view, comma separated. Defaults to the site owner.
# ADMIN_DIDS=did:plc:...

# ---- Storage / upstreams ----
DB_PATH=./data/shitsky38.sqlite
APPVIEW_URL=https://public.api.bsky.app
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
# Set to 0 to stop consuming the firehose (votes written through this app are still counted)
JETSTREAM_ENABLED=1

# ---- Production only (non-loopback PUBLIC_URL) ----
# Generate with: npm run keygen   -- then paste the PKCS#8 PEM values here (\n-escaped, one line each)
PRIVATE_KEY_1=
PRIVATE_KEY_2=
PRIVATE_KEY_3=

# ---- Railway ----
# Attach a volume mounted at /data, then point the database at it:
#   DB_PATH=/data/shitsky38.sqlite
#   PUBLIC_URL=https://shitsky38.com
# PORT is injected by Railway — do not set it.
# COOKIE_SECRET and PRIVATE_KEY_n can be left empty: the app mints them on first boot and
# keeps them in the database on that volume.
